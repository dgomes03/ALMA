   Copyright 2025 Mistral AI, Apache License 2.0 — see THIRD_PARTY_NOTICES.md.
   Reduced to the widgets ALMA uses; ALMA colours replace Mistral's. */

$alma_accent: #4A9FD8;

* {
    scrollbar-size: 1 1;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
    scrollbar-color: $foreground-muted 40%;
    scrollbar-color-hover: $foreground-muted;
    scrollbar-color-active: $alma_accent;
}

Screen {
    background: #ffffff;
}

Horizontal {
    width: 100%;
    height: auto;
}

TextArea > .text-area--cursor {
    color: $foreground;
}

/* ── Layout ─────────────────────────────────────────────── */

#chat {
    layout: stream;
    height: 1fr;
    width: 100%;
    background: transparent;
    padding: 0 1;
    align-vertical: bottom;
}

#messages {
    layout: stream;
    width: 100%;
    height: auto;
    margin-top: 1;
}

#loading-area {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 1 1 0 1;
}

#loading-area-content {
    width: 1fr;
    height: auto;
}

#bottom-app-container,
#input-container {
    height: auto;
    width: 100%;
    background: transparent;
    padding: 0 1;
}

#bottom-bar {
    height: 1;
    width: 100%;
    padding: 0 1;
    color: $text-muted;
}

#bottom-hints {
    width: 1fr;
}

#bottom-model {
    width: auto;
}

/* ── Input ──────────────────────────────────────────────── */

#input-box {
    height: auto;
    width: 100%;
    background: transparent;
    border: none;
    border-top: solid $foreground-muted;
    border-bottom: solid $foreground-muted;

    &:focus-within {
        border-top: solid $alma_accent;
        border-bottom: solid $alma_accent;
    }
}

#input-body {
    height: auto;
}

#prompt {
    width: auto;
    background: transparent;
    color: $alma_accent;
    text-style: bold;
    padding: 0 1 0 0;
}

#input, #input:focus {
    background: transparent;
}

#input > .text-area--cursor-line {
    background: transparent;
}

#input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 50vh;
    background: transparent;
    color: $foreground;
    border: none;
    padding: 0;
    scrollbar-visibility: hidden;
}

#completion-popup {
    display: none;
    width: 100%;
    height: auto;
    color: $foreground;
    background: #ffffff;
    border: solid $foreground-muted;
    overflow-y: auto;
}

#completion-popup _CompletionRow {
    height: auto;
    width: 1fr;
}

#completion-popup _CompletionItem {
    height: auto;
}

#completion-popup .completion-command {
    max-width: 30%;
    margin-right: 2;
    text-style: bold;
}

#completion-popup .completion-description {
    width: 1fr;
    color: $text-muted;
}

#completion-popup _CompletionRow.completion-selected .completion-command {
    text-style: bold reverse;
}

#completion-popup _CompletionRow.completion-selected .completion-description {
    color: $foreground;
    text-style: italic;
}

/* ── Banner ─────────────────────────────────────────────── */

#banner-container {
    padding: 1 0 0 0;
    width: auto;
    height: auto;
}

.banner-line {
    width: auto;
    height: 1;
}

#banner-brand {
    color: $alma_accent;
    text-style: bold;
    width: auto;
}

.banner-meta {
    color: $foreground;
    width: auto;
}

.banner-meta-muted {
    color: $text-muted;
    width: auto;
}

.banner-cmd {
    color: $alma_accent;
    width: auto;
}

/* ── Messages ───────────────────────────────────────────── */

Markdown {
    color: $foreground;

    .code_inline {
        color: $success;
        background: transparent;
        text-style: bold;
    }

    MarkdownFence {
        overflow-x: auto;
        max-width: 95%;
        background: transparent;
    }

    MarkdownTable {
        background: transparent;
    }

    MarkdownBlockQuote {
        background: transparent;
        border-left: outer $foreground-muted;
    }

    MarkdownH1, MarkdownH2, MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6 {
        color: $alma_accent;
        text-style: bold;
        background: transparent;
        content-align: left top;
        margin: 1 0 0 0;
    }
}

.user-message {
    margin-top: 1;
    width: 100%;
    height: auto;
}

.user-message-wrapper {
    margin-top: 1;
    width: 100%;
    height: auto;
}

.user-message-container {
    width: 100%;
    height: auto;
}

.user-message-prompt {
    width: auto;
    height: auto;
    color: $alma_accent;
    text-style: bold;
}

.user-message-content {
    width: 1fr;
    height: auto;
    text-style: bold;
}

.slash-command-message .user-message-content {
    color: $alma_accent;
}

.user-message-separator {
    width: 100%;
    height: 1;
    color: $text-muted;
}

.assistant-message {
    layout: stream;
    margin-top: 1;
    width: 100%;
    height: auto;
    padding: 0 2 0 2;

    Markdown {
        width: 100%;
        height: auto;
        padding: 0;
        margin: 0;

        & > MarkdownBlock:last-child {
            margin-bottom: 0;
        }
    }
}

.interrupt-message,
.error-message,
.notice-message {
    margin-top: 1;
    height: auto;
    width: 100%;
}

.interrupt-container,
.error-container,
.notice-container {
    width: 100%;
    height: auto;
}

.interrupt-border,
.error-border,
.notice-border {
    width: auto;
    height: 100%;
    padding: 0 1 0 2;
    color: $text-muted;
}

.interrupt-content {
    width: 1fr;
    height: auto;
    color: $warning;
}

.error-content {
    width: 1fr;
    height: auto;
    color: $error;
    text-style: bold;
}

.notice-content {
    width: 1fr;
    height: auto;
    color: $text-muted;
}

/* ── Tool calls and loading ─────────────────────────────── */

.tool-call {
    width: 100%;
    height: auto;
    margin-top: 1;
    padding: 0 0 0 2;
}

.status-indicator-icon {
    width: auto;
    height: auto;
    color: $alma_accent;
    margin-right: 1;

    &.success {
        color: $success;
    }

    &.error {
        color: $error;
    }
}

.status-indicator-text {
    width: 1fr;
    height: auto;
    color: $text-muted;
}

.loading-widget {
    width: 100%;
    height: auto;
    color: $text-muted;
}

.loading-container,
.loading-indicator,
.loading-status,
.loading-hint {
    width: auto;
    height: auto;
}

.loading-indicator {
    margin-right: 1;
}

.loading-hint {
    color: $text-muted;
}
